<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fill the gaps (Linguize Lab). Feature name, Home entry and screen title. -->
    <string name="lab_gap_filler_title">Fill the gaps</string>
    <string name="lab_gap_filler_home_summary">Write what you can. Leave the rest in [brackets].</string>
    <string name="lab_gap_filler_placeholder">Write in Spanish or Catalan. Put words you don\'t know in [brackets].</string>
    <!-- Sample message: Spanish with English gaps in brackets. Not translated. -->
    <string name="lab_gap_filler_sample" translatable="false">Hola, ¿puedes [pick me up] a las 8? Tengo que [drop off] las llaves.</string>
    <string name="lab_gap_filler_fill">Fill the gaps</string>
    <string name="lab_gap_filler_no_text">No text to fill</string>
    <string name="lab_gap_filler_filling">Filling the gaps</string>
    <string name="lab_gap_filler_note">Only the gaps change. Fills are not saved.</string>

    <!-- Result -->
    <plurals name="lab_gap_filler_filled_count">
        <item quantity="one">%d gap filled</item>
        <item quantity="other">%d gaps filled</item>
    </plurals>
    <string name="lab_gap_filler_nothing">No gaps found</string>
    <string name="lab_gap_filler_nothing_hint">Put words you don\'t know in [brackets]</string>
    <string name="lab_gap_filler_your_text">Your text</string>
    <string name="lab_gap_filler_fills">Filled in</string>
    <!-- One fill: the writer's own phrase, then what replaced it. -->
    <string name="lab_gap_filler_becomes">%1$s becomes %2$s</string>
    <string name="lab_gap_filler_other_ways">Other ways to say it</string>
    <string name="lab_gap_filler_use_option">Use %1$s</string>
    <string name="lab_gap_filler_in_use">In use</string>

    <!-- Actions -->
    <string name="lab_gap_filler_put_back">Put back</string>
    <string name="lab_gap_filler_check">Check it</string>
    <string name="lab_gap_filler_copy">Copy</string>
    <string name="lab_gap_filler_use">Use text</string>

    <!-- The offer on the check card -->
    <plurals name="lab_gap_filler_offer_marked">
        <item quantity="one">%d gap in brackets</item>
        <item quantity="other">%d gaps in brackets</item>
    </plurals>
    <string name="lab_gap_filler_offer_mixed">Some words look like English</string>
    <string name="lab_gap_filler_open">Fill the gaps in this text</string>
</resources>
