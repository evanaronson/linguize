    <!-- How it works. -->
    <string name="lab_vocab_gaps_how">How it works</string>
    <string name="lab_vocab_gaps_how_text">Linguize matches each word you typed to its dictionary form and part of speech, so “casas” counts toward “casa”. When the part of speech isn\'t known, it matches by spelling.</string>
    <string name="lab_vocab_gaps_how_ambiguous">A word that could be more than one entry counts toward each of them. “Fue” counts toward both “ser” and “ir”.</string>
