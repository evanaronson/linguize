{
  "type": "object",
  "properties": {
    "variety": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "fine",
        "worth_a_look",
        "risky"
      ]
    },
    "warmth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1 cold, 3 neutral, 5 very warm."
    },
    "directness": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1 very indirect, 3 plain, 5 blunt."
    },
    "formality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1 very casual, 3 neutral, 5 very formal."
    },
    "drivers": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          }
        },
        "required": [
          "quote",
          "effect"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "text",
          "why"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "variety",
    "summary",
    "risk",
    "warmth",
    "directness",
    "formality",
    "drivers",
    "notes",
    "versions"
  ],
  "additionalProperties": false
}
