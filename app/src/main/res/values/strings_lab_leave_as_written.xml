<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The card's last button on a clean check from another app (or one whose every change was
        skipped), with History on: the text stays as the writer wrote it, the card closes, and the
        check is saved. "Save", because saving is all it does: "Leave as written" read as if the
        writer were still deciding whether to change the text. Not "Keep" (keep is not the word
        for saving) and not Done or OK (the card's last button says what it does).
    -->
    <string name="lab_leave_as_written">Save</string>
    <!--
        The same button with History off: it saves nothing and only closes the card, so it says
        Close. "Save" there would be false.
    -->
    <string name="lab_leave_as_written_close">Close</string>
    <!-- On a saved check that was closed with Save (Leave as written), under the unchanged text. -->
    <string name="lab_left_as_written">Left as written</string>
</resources>
