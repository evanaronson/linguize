<resources>
    <!-- Settings › Checking: the switch's title. -->
    <string name="lab_type_to_accept_title">Type to accept</string>
    <!-- Settings › Checking: under the switch's title, why it exists. -->
    <string name="lab_type_to_accept_summary">Type each change yourself to accept it, so you learn it</string>
    <!-- On the card, the empty field that stands in for Accept. -->
    <string name="lab_type_to_accept_placeholder">Type the change</string>
