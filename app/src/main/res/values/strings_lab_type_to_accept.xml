    <string name="lab_type_to_accept_off_spoken">Not quite. Check the change above</string>
    <!-- Screen readers: read out as the typed change matches, just before it is accepted. -->
    <string name="lab_type_to_accept_correct">Correct</string>
    <!-- Settings › Checking, under Type to accept: a light vibration when a typed change matches. -->
    <string name="lab_type_to_accept_vibrate">Vibrate when correct</string>
    <!-- Settings › Checking, under Type to accept: a short sound when a typed change matches. -->
    <string name="lab_type_to_accept_sound">Sound when correct</string>
    <!-- Settings › Checking: under Sound when correct. -->
    <string name="lab_type_to_accept_sound_summary">Not when your phone is on silent or vibrate</string>
